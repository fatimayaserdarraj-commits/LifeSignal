# Every integration below is optional. LifeSignal runs fully offline with
# sensible simulated/fallback behaviour when a section is left unset.

# --- CAMARA APIs via Nokia Network-as-Code --------------------------------
# CAMARA_MODE=simulate keeps the whole demo on deterministic synthetic
# network signals (default, zero credentials needed). Set to "live" and
# supply NOKIA_NAC_API_KEY to call the real Network-as-Code sandbox.
CAMARA_MODE=simulate
NOKIA_NAC_BASE_URL=https://network-as-code.p-eu.rapidapi.com
NOKIA_NAC_API_KEY=

# --- LLM (Groq) -------------------------------------------------------
# Leave empty to use the built-in templated reasoning-trace generator.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Supabase (Postgres) -----------------------------------------------
# Leave empty to keep incident/risk-zone history in-process (non-durable).
SUPABASE_URL=
SUPABASE_KEY=

# --- Twilio alerting -----------------------------------------------------
# Leave empty to log alerts to stdout instead of sending SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_ALERT_TO_NUMBER=

# --- Agent tuning ---------------------------------------------------------
OCCUPANCY_POLL_INTERVAL_SECONDS=2.0
OCCUPANCY_MAX_TICKS=40
CONGESTION_THRESHOLD=0.7
RISK_ZONE_GRID_SIZE_KM=1.0

# --- App --------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
